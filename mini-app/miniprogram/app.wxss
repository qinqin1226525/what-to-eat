/* app.wxss —— 全局样式 */

page {
  background: #f7f7f7;
  color: #333;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #222;
}

/* 主按钮 */
.btn-primary {
  background: #ff9a3c;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  width: 100%;
  display: block;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-secondary {
  background: #fff;
  color: #ff9a3c;
  border: 2rpx solid #ff9a3c;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  display: block;
}

.btn-ghost {
  background: transparent;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  display: block;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #fff5e6;
  color: #ff9a3c;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-gray {
  background: #f0f0f0;
  color: #666;
}

.tag-green {
  background: #e8f7ed;
  color: #2da44e;
}

.tag-red {
  background: #fde8e8;
  color: #d14545;
}

/* 输入框 */
.input {
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: #eee;
  margin: 24rpx 0;
}

/* 文字 */
.text-muted { color: #999; font-size: 24rpx; }
.text-bold { font-weight: 600; }
.text-center { text-align: center; }

/* 角色徽章 */
.role-main::before { content: "🍖 "; }
.role-soup::before { content: "🍲 "; }
role-staple::before { content: "🍚 "; }
role-veg::before { content: "🥬 "; }
role-cold::before { content: "🥗 "; }
.role-breakfast::before { content: "🥣 "; }

/* 加载中 */
.loading {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}
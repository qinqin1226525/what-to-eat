<!-- pages/chat/chat.wxml -->
<view class="container chat-page">

  <!-- 顶部状态栏（用量） -->
  <view wx:if="{{usage.calls > 0}}" class="usage-bar">
    <text>💬 {{usage.calls}} 次对话 · {{usage.total}} tokens</text>
    <view class="clear-btn" bindtap="onClear">清空</view>
  </view>

  <!-- 消息列表 -->
  <scroll-view scroll-y class="msg-list" enable-flex>
    <block wx:for="{{messages}}" wx:key="id" wx:for-item="m">
      <!-- 用户消息（右） -->
      <view wx:if="{{m.role === 'user'}}" class="msg-row msg-user">
        <view class="msg-bubble msg-bubble-user">{{m.content}}</view>
        <view class="avatar avatar-user">👤</view>
      </view>

      <!-- AI 消息（左） -->
      <block wx:elif="{{m.role === 'ai'}}">
        <view class="msg-row msg-ai">
          <view class="avatar avatar-ai">🤖</view>
          <view class="msg-bubble msg-bubble-ai {{m.error ? 'msg-error' : ''}}">
            <block wx:if="{{m.loading}}">
              <view class="typing">
                <text class="dot">·</text>
                <text class="dot">·</text>
                <text class="dot">·</text>
                <text class="typing-text">AI 正在想</text>
              </view>
            </block>
            <block wx:else>
              <text>{{m.content}}</text>
            </block>
          </view>
        </view>
      </block>
    </block>

    <!-- 底部占位（让最后一条消息能滚上去） -->
    <view style="height: 40rpx;"></view>
  </scroll-view>

  <!-- 快捷问题（没消息或只有欢迎时显示） -->
  <view wx:if="{{messages.length <= 1 && !sending}}" class="quick-prompts">
    <view class="quick-title">💡 试试这些：</view>
    <view class="quick-grid">
      <block wx:for="{{quickPrompts}}" wx:key="text" wx:for-item="p">
        <view class="quick-chip" data-text="{{p.text}}" bindtap="onQuickPrompt">
          <text class="quick-icon">{{p.icon}}</text>
          <text class="quick-text">{{p.text}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 输入区 -->
  <view class="input-bar">
    <textarea
      class="input-textarea"
      value="{{inputText}}"
      bindinput="onInput"
      placeholder="问点什么..."
      auto-height
      maxlength="500"
      cursor-spacing="20rpx"
      adjust-position="{{true}}"
      hold-keyboard="{{true}}"
    />
    <button class="send-btn {{sending ? 'send-btn-disabled' : ''}}" bindtap="onSend" disabled="{{sending}}">
      {{sending ? '...' : 'send'}}
    </button>
  </view>

</view>
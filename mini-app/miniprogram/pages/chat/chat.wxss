/* pages/chat/chat.wxss */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  background: #f7f7f7;
}

/* 顶部用量条 */
.usage-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #fff7ed;
  font-size: 22rpx;
  color: #92400e;
  border-bottom: 2rpx solid #fde6c4;
}

.clear-btn {
  color: #ff9a3c;
  font-weight: 600;
  padding: 4rpx 12rpx;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-ai {
  justify-content: flex-start;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.avatar-user {
  margin-left: 16rpx;
  background: #ff9a3c;
}

.avatar-ai {
  margin-right: 16rpx;
  background: #fff;
}

.msg-bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-bubble-user {
  background: #ff9a3c;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg-bubble-ai {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.msg-error {
  background: #fef2f2;
  color: #b91c1c;
  border: 2rpx solid #fecaca;
}

/* 打字动画 */
.typing {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.typing .dot {
  animation: typing 1.2s infinite;
  font-size: 32rpx;
  color: #ff9a3c;
  font-weight: 800;
}

.typing .dot:nth-child(2) { animation-delay: 0.2s; }
.typing .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

.typing-text {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 快捷问题 */
.quick-prompts {
  padding: 16rpx 24rpx 0;
}

.quick-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-chip {
  background: #fff;
  border: 2rpx solid #ffd9b3;
  border-radius: 24rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  max-width: 100%;
  font-size: 24rpx;
  color: #333;
}

.quick-chip:active {
  background: #fff7ed;
}

.quick-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.quick-text {
  flex: 1;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input-textarea {
  flex: 1;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  min-height: 48rpx;
  max-height: 200rpx;
  box-sizing: border-box;
}

.send-btn {
  background: #ff9a3c;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 0 0 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.send-btn[disabled] {
  background: #ccc;
  color: #fff;
}
<!-- pages/fridge/fridge.wxml -->
<view class="container">

  <view class="card fridge-card">
    <view class="text-muted fridge-hint">添加食材，去选菜页用「冰箱有什么」功能</view>
    <view class="fridge-row">
      <input class="input fridge-input" value="{{inputValue}}" bindinput="onInput" placeholder="输入食材，逗号分隔…" confirm-type="done" bindconfirm="onAdd" />
      <view class="btn-add {{saving ? 'disabled' : ''}}" bindtap="onAdd">加</view>
    </view>
    <view wx:if="{{items.length > 0}}" class="fridge-clear" bindtap="onClear">清空冰箱</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{items.length === 0}}" class="empty card">
    <view class="text-center text-muted">冰箱是空的，去买点菜吧 🥬</view>
    <view class="quick-tips">
      <text class="tip-chip">鸡蛋</text>
      <text class="tip-chip">西红柿</text>
      <text class="tip-chip">青菜</text>
      <text class="tip-chip">豆腐</text>
    </view>
  </view>

  <view wx:else class="card">
    <view class="text-muted fridge-count">{{items.length}} 项食材</view>
    <view class="fridge-grid">
      <block wx:for="{{items}}" wx:key="*this" wx:for-item="ing">
        <view class="fridge-item">
          <text class="fridge-name">{{ing}}</text>
          <view class="fridge-remove" data-name="{{ing}}" bindtap="onRemove">×</view>
        </view>
      </block>
    </view>
  </view>

</view>
<!-- pages/home/home.wxml —— 1 页式主页
     风格：温暖人性化（多色 + 渐变 + 大 emoji + 平滑过渡）
     整体结构：顶 4 按钮 → 冰箱+菜池 → 二级操作 → 最近 → 统计
-->
<view class="home">

  <!-- 顶部问候 -->
  <view class="home-header">
    <view class="home-title" style="font-size: {{36 * fontScale}}rpx;">今天吃什么</view>
    <view class="home-sub" style="font-size: {{24 * fontScale}}rpx;">
      <text wx:if="{{loading}}">加载中…</text>
      <text wx:elif="{{customDishes.length === 0}}">先告诉我你会做哪些菜</text>
      <text wx:else>菜池 {{customDishes.length}} 道 · 冰箱 {{fridgeItems.length}} 项</text>
    </view>
  </view>

  <!-- 顶部 4 按钮横排（主导航） -->
  <view class="top-nav">
    <view class="top-nav-btn" catchtap="onRandomPick">
      <text class="top-nav-emoji" style="font-size: {{40 * fontScale}}rpx;">🎲</text>
      <text class="top-nav-text" style="font-size: {{22 * fontScale}}rpx;">抽一套</text>
    </view>
    <view class="top-nav-btn" catchtap="onManualRecord">
      <text class="top-nav-emoji" style="font-size: {{40 * fontScale}}rpx;">📝</text>
      <text class="top-nav-text" style="font-size: {{22 * fontScale}}rpx;">记录</text>
    </view>
    <view class="top-nav-btn" catchtap="onScrollToStats">
      <text class="top-nav-emoji" style="font-size: {{40 * fontScale}}rpx;">📊</text>
      <text class="top-nav-text" style="font-size: {{22 * fontScale}}rpx;">统计</text>
    </view>
    <view class="top-nav-btn" catchtap="onOpenSettings">
      <text class="top-nav-emoji" style="font-size: {{40 * fontScale}}rpx;">⚙</text>
      <text class="top-nav-text" style="font-size: {{22 * fontScale}}rpx;">设置</text>
    </view>
  </view>

  <!-- 冰箱 = 搜菜谱（输入菜名 → 出菜谱）-->
  <view class="section">
    <view class="section-label" style="font-size: {{22 * fontScale}}rpx;">🥬 搜菜谱</view>
    <view class="search-row">
      <input class="search-input" value="{{searchInput}}" bindinput="onSearchInput"
             placeholder="搜菜名、食材、标签…" confirm-type="search" />
    </view>
    <!-- 搜索结果列表 -->
    <view class="search-results" wx:if="{{searchResults.length > 0}}">
      <block wx:for="{{searchResults}}" wx:key="name" wx:for-item="d">
        <view class="search-result-row" data-name="{{d.name}}" catchtap="onSearchDishTap" hover-class="search-result-hover">
          <text class="search-result-emoji" style="font-size: {{36 * fontScale}}rpx;">{{d.emoji}}</text>
          <view class="search-result-info">
            <view class="search-result-name" style="font-size: {{28 * fontScale}}rpx;">{{d.name}}</view>
            <view class="search-result-meta" style="font-size: {{20 * fontScale}}rpx;">{{d.role}} · 约 {{d.time}} 分钟</view>
          </view>
          <text class="search-result-arrow">›</text>
        </view>
      </block>
    </view>
    <!-- 空输入时只显示提示 -->
    <view wx:elif="{{!searchInput}}" class="search-hint">
      <text>输入菜名 / 食材 / 标签开始搜</text>
    </view>
    <!-- 搜索无结果 -->
    <view wx:elif="{{searchInput && searchResults.length === 0}}" class="search-empty">
      没找到「{{searchInput}}」相关的菜谱
    </view>
  </view>

  <!-- 菜池 chip 行（可加可删） -->
  <view class="section">
    <view class="section-label section-label-clickable" data-section="pool" catchtap="onToggleSection">
      <text>🍳 我会做的</text>
      <text class="section-label-sub" style="font-size: {{20 * fontScale}}rpx;">{{customDishes.length}} 道</text>
      <text class="section-toggle">{{expanded.pool ? '▼' : '▶'}}</text>
    </view>
    <!-- 已有菜池（chip + × 删除单条） -->
    <scroll-view scroll-x class="chip-scroll" enhanced show-scrollbar="{{false}}">
      <block wx:for="{{customDishes}}" wx:key="*this">
        <view class="chip chip-custom" style="font-size: {{24 * fontScale}}rpx;" data-name="{{item}}" catchtap="onRemoveDish">
          {{item}}<text class="chip-x">×</text>
        </view>
      </block>
      <view wx:if="{{customDishes.length === 0}}" class="chip-empty" style="font-size: {{22 * fontScale}}rpx;">还没有菜，{{expanded.pool ? '下面加' : '点 ▶ 加'}}</view>
    </scroll-view>

    <!-- 批量输入：5 个 input（默认收起） -->
    <view wx:if="{{expanded.pool}}">
      <view class="batch-inputs">
        <block wx:for="{{poolInputs}}" wx:key="id" wx:for-item="inp">
          <input class="batch-input" value="{{inp.value}}" data-id="{{inp.id}}"
                 bindinput="onPoolInputChange" placeholder="菜名 {{inp.id}}" />
        </block>
      </view>

      <!-- 操作行：添加 + 保存 -->
      <view class="pool-actions">
      <view class="pool-add-row" catchtap="onAddPoolInput">+ 加一行</view>
      <view class="pool-save-btn {{savingPool ? 'disabled' : ''}}" catchtap="onSavePool">{{savingPool ? '保存中…' : '保存菜池'}}</view>
    </view>
    </view>
  </view>

  <!-- 二级操作 -->
  <view class="sub-actions">
    <view class="sub-action-btn" catchtap="onAiInspire">
      <text style="font-size: {{24 * fontScale}}rpx;">🤖 AI 顾问</text>
    </view>
  </view>

  <!-- 最近选了 -->
  <view class="recent" wx:if="{{recentPicks.length > 0}}">
    <view class="recent-label section-label-clickable" data-section="recent" catchtap="onToggleSection">
      <text style="font-size: {{22 * fontScale}}rpx;">最近 7 天吃过</text>
      <text class="section-toggle">{{expanded.recent ? '▼' : '▶'}}</text>
    </view>
    <view wx:if="{{expanded.recent}}" class="recent-list" style="font-size: {{24 * fontScale}}rpx;">
      <text wx:for="{{recentPicks}}" wx:key="*this" class="recent-item">{{item}}</text>
    </view>
  </view>

  <!-- 统计 section（永久显示在底部） -->
  <view class="stats-section" id="stats-section">
    <view class="stats-section-title section-label-clickable" data-section="stats" catchtap="onToggleSection">
      <text>📊 本月饮食报告</text>
      <text class="section-toggle">{{expanded.stats ? '▼' : '▶'}}</text>
    </view>
    <view wx:if="{{expanded.stats}}">
    <view class="stats-section-sub" style="font-size: {{22 * fontScale}}rpx;">
      <block wx:if="{{loading}}">加载中…</block>
      <block wx:elif="{{stats.totalMeals === 0}}">本月还没记录，点点上面的按钮开始吧</block>
      <block wx:else>本月 {{stats.totalMeals}} 条记录 · {{stats.activeDays}} 天</block>
    </view>

    <view wx:if="{{stats.totalMeals > 0}}" class="stats-cards">
      <view class="stats-card">
        <view class="stats-num">{{stats.totalMeals}}</view>
        <view class="stats-label">本月吃了（道）</view>
      </view>
      <view class="stats-card">
        <view class="stats-num stats-num-green">{{stats.activeDays}}</view>
        <view class="stats-label">有记录天数</view>
      </view>
      <view class="stats-card">
        <view class="stats-num stats-num-purple">{{stats.avgPerDay}}</view>
        <view class="stats-label">平均每天（餐）</view>
      </view>
    </view>

    <view wx:if="{{stats.topDishes.length > 0}}" class="stats-sub-section">
      <view class="stats-sub-title" style="font-size: {{24 * fontScale}}rpx;">🏆 Top {{stats.topDishes.length}}</view>
      <block wx:for="{{stats.topDishes}}" wx:key="rank" wx:for-item="d">
        <view class="stats-top-row">
          <view class="stats-top-rank" style="background: {{d.color}}; font-size: {{22 * fontScale}}rpx;">{{d.rank}}</view>
          <view class="stats-top-name" style="font-size: {{26 * fontScale}}rpx;">{{d.name}}</view>
          <view class="stats-top-count" style="font-size: {{22 * fontScale}}rpx;">{{d.count}} 次</view>
        </view>
      </block>
    </view>

    <view wx:if="{{stats.totalMeals > 0}}" class="stats-sub-section">
      <view class="stats-sub-title" style="font-size: {{24 * fontScale}}rpx;">🍱 三餐分布</view>
      <block wx:for="{{stats.mealDist}}" wx:key="meal" wx:for-item="m">
        <view class="stats-meal-row">
          <view class="stats-meal-label" style="font-size: {{26 * fontScale}}rpx;">{{m.meal}}</view>
          <view class="stats-meal-bar-wrap">
            <view class="stats-meal-bar" style="width: {{m.fill}}%; background: {{m.color}};"></view>
          </view>
          <view class="stats-meal-count" style="font-size: {{22 * fontScale}}rpx;">{{m.count}}</view>
        </view>
      </block>
    </view>
    </view>
  </view>

  <!-- 搜菜谱详情 modal（点搜索结果触发） -->
  <view wx:if="{{searchDetail}}" class="search-detail-mask" catchtap="closeSearchDetail">
    <view class="search-detail-card" catchtap="">
      <view class="search-detail-header">
        <text class="search-detail-emoji" style="font-size: {{64 * fontScale}}rpx;">{{searchDetail.emoji}}</text>
        <view class="search-detail-title-block">
          <view class="search-detail-title" style="font-size: {{36 * fontScale}}rpx;">{{searchDetail.name}}</view>
          <view class="search-detail-meta" style="font-size: {{22 * fontScale}}rpx;">{{searchDetail.role}} · 约 {{searchDetail.time}} 分钟</view>
        </view>
        <view class="search-detail-close" catchtap="closeSearchDetail">✕</view>
      </view>

      <scroll-view scroll-y class="search-detail-scroll">
        <block wx:if="{{searchDetail.ingredients.length > 0}}">
          <view class="sd-section-title" style="font-size: {{24 * fontScale}}rpx;">🥕 食材</view>
          <view class="sd-text" style="font-size: {{26 * fontScale}}rpx;">{{searchDetail.ingredientsStr}}</view>
        </block>

        <block wx:if="{{searchDetail.seasonings.length > 0}}">
          <view class="sd-section-title" style="font-size: {{24 * fontScale}}rpx;">🧂 调料</view>
          <view class="sd-text" style="font-size: {{26 * fontScale}}rpx;">{{searchDetail.seasoningsStr}}</view>
        </block>

        <block wx:if="{{searchDetail.steps.length > 0}}">
          <view class="sd-section-title" style="font-size: {{24 * fontScale}}rpx;">📝 做法</view>
          <block wx:for="{{searchDetail.steps}}" wx:key="*this" wx:for-item="step" wx:for-index="sidx">
            <view class="sd-step" style="font-size: {{26 * fontScale}}rpx;">
              <text class="sd-step-num">{{sidx + 1}}.</text>
              <text class="sd-step-text">{{step}}</text>
            </view>
          </block>
        </block>

        <view wx:if="{{searchDetail.tip}}" class="sd-tip" style="font-size: {{26 * fontScale}}rpx;">
          💡 {{searchDetail.tip}}
        </view>
      </scroll-view>

      <view class="search-detail-actions">
        <view class="btn-primary search-detail-eat" catchtap="onSearchEat" hover-class="btn-primary-hover">就做这个 ✓</view>
      </view>
    </view>
  </view>

  <!-- 抽到结果：全屏 modal -->
  <view wx:if="{{picked}}" class="result-mask" bindtap="closePicked">
    <view class="result-card" catchtap="_noop">
      <view class="result-close" bindtap="closePicked">✕</view>
      <view class="result-title" style="font-size: {{32 * fontScale}}rpx;">
        <block wx:if="{{picked.source === 'ai'}}">🤖 AI 顾问</block>
        <block wx:elif="{{picked.source === 'fridge'}}">🥬 冰箱有什么</block>
        <block wx:else>🎲 今日推荐</block>
      </view>
      <view wx:if="{{pickedHint}}" class="result-hint" style="font-size: {{22 * fontScale}}rpx;">{{pickedHint}}</view>
      <view wx:if="{{pickedMeals.length > 0}}" class="picked-hint" style="font-size: {{22 * fontScale}}rpx;">✓ 已选 {{pickedMeals.length}} 道：{{pickedMeals.join('、')}}</view>
      <block wx:for="{{picked.dishes}}" wx:key="*this" wx:for-item="dish" wx:for-index="idx">
        <view wx:if="{{picked.dishInfos && picked.dishInfos[idx]}}">
          <!-- 左侧：emoji + 菜名（带 › 展开符号）+ role·时间 -->
          <view class="result-row-main">
            <view class="result-emoji" style="font-size: {{48 * fontScale}}rpx;">{{picked.dishInfos[idx].emoji}}</view>
            <view class="result-info">
              <view class="result-dish-line" data-idx="{{idx}}" catchtap="onToggleExpand" hover-class="result-dish-line-hover">
                <text class="result-dish" style="font-size: {{34 * fontScale}}rpx;">{{dish}}</text>
                <view class="result-toggle">
                  <text wx:if="{{picked.expanded && picked.expanded[idx]}}" style="font-size: {{28 * fontScale}}rpx;">▼</text>
                  <text wx:else style="font-size: {{28 * fontScale}}rpx;">›</text>
                </view>
              </view>
              <view class="result-meta" style="font-size: {{22 * fontScale}}rpx;">
                {{picked.dishInfos[idx].role}} · 约 {{picked.dishInfos[idx].time}} 分钟
              </view>
              <view wx:if="{{picked.reasons && picked.reasons[idx] && picked.reasons[idx].reason}}" class="result-reason" style="font-size: {{22 * fontScale}}rpx;">
                💡 {{picked.reasons[idx].reason}}
              </view>
            </view>
          </view>

          <!-- 展开：步骤 + 小贴士（点 › 触发） -->
          <view wx:if="{{picked.expanded && picked.expanded[idx]}}" class="result-expand">
            <block wx:if="{{picked.dishInfos[idx].ingredients && picked.dishInfos[idx].ingredients.length > 0}}">
              <view class="result-expand-section" style="font-size: {{24 * fontScale}}rpx;">
                <text class="result-expand-label">食材：</text>
                <text class="result-expand-text">{{picked.dishInfos[idx].ingredientsStr}}</text>
              </view>
            </block>
            <block wx:if="{{picked.dishInfos[idx].seasonings && picked.dishInfos[idx].seasonings.length > 0}}">
              <view class="result-expand-section" style="font-size: {{24 * fontScale}}rpx;">
                <text class="result-expand-label">调料：</text>
                <text class="result-expand-text">{{picked.dishInfos[idx].seasoningsStr}}</text>
              </view>
            </block>
            <block wx:if="{{picked.dishInfos[idx].steps && picked.dishInfos[idx].steps.length > 0}}">
              <view class="result-expand-title" style="font-size: {{24 * fontScale}}rpx;">做法</view>
              <block wx:for="{{picked.dishInfos[idx].steps}}" wx:key="*this" wx:for-item="step" wx:for-index="sidx">
                <view class="result-expand-step" style="font-size: {{24 * fontScale}}rpx;">
                  <text class="result-step-num">{{sidx + 1}}.</text>
                  <text>{{step}}</text>
                </view>
              </block>
            </block>
            <view wx:if="{{picked.dishInfos[idx].tip}}" class="result-tip" style="font-size: {{24 * fontScale}}rpx;">
              💡 {{picked.dishInfos[idx].tip}}
            </view>
          </view>

          <!-- 右侧：4 个按钮垂直 -->
          <view class="result-row-buttons">
            <view class="result-btn {{pickedMeals.indexOf(dish) >= 0 ? 'result-btn-eat-done' : 'result-btn-eat'}}"
                  style="font-size: {{24 * fontScale}}rpx;" data-dish="{{dish}}" catchtap="onEat">
              <block wx:if="{{pickedMeals.indexOf(dish) >= 0}}">✓ 已选</block>
              <block wx:else>✓ 选这道</block>
            </view>
            <view class="result-btn result-btn-swap" style="font-size: {{24 * fontScale}}rpx;" data-idx="{{idx}}" catchtap="onSwapDish">🔄 换一道</view>
            <view class="result-btn result-btn-custom" style="font-size: {{24 * fontScale}}rpx;" data-idx="{{idx}}" catchtap="onCustomDish">🍽 别的</view>
            <view class="result-btn result-btn-skip" style="font-size: {{24 * fontScale}}rpx;" data-idx="{{idx}}" catchtap="onSkip">✕ 跳过</view>
          </view>
        </view>
      </block>

      <!-- 底部：再来一道 chip 行 + 就做这些主按钮 -->
      <view class="result-footer">
        <view class="footer-label" style="font-size: {{22 * fontScale}}rpx;">➕ 再来一道</view>
        <view class="role-add-row">
          <view class="role-add-chip" data-role="主菜" catchtap="addMoreDish">🍖 主菜</view>
          <view class="role-add-chip" data-role="汤" catchtap="addMoreDish">🥣 汤</view>
          <view class="role-add-chip" data-role="主食" catchtap="addMoreDish">🍚 主食</view>
          <view class="role-add-chip" data-role="凉菜" catchtap="addMoreDish">🥗 凉菜</view>
        </view>
        <view class="result-btn-finish {{pickedMeals.length === 0 ? 'result-btn-finish-disabled' : ''}}"
              catchtap="finishEat" style="font-size: {{30 * fontScale}}rpx;">
          <block wx:if="{{pickedMeals.length === 0}}">👆 选几道菜再点这个</block>
          <block wx:elif="{{pickedMeals.length === 1}}">✅ 就做 {{pickedMeals[0]}}</block>
          <block wx:else>✅ 就做这些（{{pickedMeals.length}} 道）</block>
        </view>
      </view>
    </view>
  </view>

  <!-- 「别的」modal：手动输入菜名 + 模糊查询 -->
  <view wx:if="{{showCustomDish}}" class="custom-mask" bindtap="closeCustomDish">
    <view class="custom-card" catchtap="_noop">
      <view class="custom-title" style="font-size: {{32 * fontScale}}rpx;">换个别的</view>
      <view class="custom-sub" style="font-size: {{22 * fontScale}}rpx;">输入菜名，或从下方候选里挑</view>
      <input class="custom-input" value="{{customInput}}" bindinput="onCustomInput"
             bindconfirm="onCustomConfirm" confirm-type="done" placeholder="输入菜名…" focus="{{customFocus}}" />
      <view wx:if="{{customCandidates.length > 0}}" class="custom-candidates">
        <view class="custom-candidates-title" style="font-size: {{22 * fontScale}}rpx;">从菜池里匹配（{{customCandidates.length}}）</view>
        <block wx:for="{{customCandidates}}" wx:key="*this">
          <view class="custom-candidate" style="font-size: {{28 * fontScale}}rpx;" data-name="{{item}}" bindtap="onPickCandidate">{{item}}</view>
        </block>
      </view>
      <view wx:elif="{{customInput}}">
        <view class="custom-add-new" style="font-size: {{26 * fontScale}}rpx;" bindtap="onCustomConfirm">
          ➕ 添加「{{customInput}}」到菜池
        </view>
      </view>
      <view class="custom-actions">
        <view class="btn-secondary" bindtap="closeCustomDish">取消</view>
      </view>
    </view>
  </view>

  <!-- 手动记录 modal（按饮食报告风格：温暖米色 + 卡片化） -->
  <view wx:if="{{showManualLog}}" class="manual-mask" catchtap="closeManualLog">
    <view class="manual-card" catchtap="_noop">
      <view class="manual-header">
        <view class="manual-icon">📝</view>
        <view class="manual-title" style="font-size: {{32 * fontScale}}rpx;">{{manualForm.date}} · 手动记录</view>
        <view class="manual-close" catchtap="closeManualLog">✕</view>
      </view>
      <view class="manual-meta" style="font-size: {{22 * fontScale}}rpx;">多个菜用逗号分隔 · 可只填一餐</view>

      <!-- 日期选择器 -->
      <view class="manual-date-card" catchtap="onManualDateTap">
        <text class="manual-date-label" style="font-size: {{22 * fontScale}}rpx;">📅 日期</text>
        <picker mode="date" value="{{manualForm.date}}" bindchange="onManualField" data-field="date">
          <view class="manual-date-value" style="font-size: {{28 * fontScale}}rpx;">{{manualForm.date}}</view>
        </picker>
      </view>

      <!-- 3 段：早/午/晚 -->
      <view class="manual-meal-section">
        <view class="manual-meal-header">
          <text class="manual-meal-emoji">☀️</text>
          <text class="manual-meal-name" style="font-size: {{28 * fontScale}}rpx;">早餐</text>
          <text wx:if="{{manualForm.breakfast}}" class="manual-meal-count" style="font-size: {{20 * fontScale}}rpx;">已填</text>
        </view>
        <input class="manual-meal-input" value="{{manualForm.breakfast}}" bindinput="onManualField" data-field="breakfast" placeholder="例：面包,牛奶" />
      </view>

      <view class="manual-meal-section">
        <view class="manual-meal-header">
          <text class="manual-meal-emoji">🌞</text>
          <text class="manual-meal-name" style="font-size: {{28 * fontScale}}rpx;">午餐</text>
          <text wx:if="{{manualForm.lunch}}" class="manual-meal-count" style="font-size: {{20 * fontScale}}rpx;">已填</text>
        </view>
        <input class="manual-meal-input" value="{{manualForm.lunch}}" bindinput="onManualField" data-field="lunch" placeholder="例：宫保鸡丁,米饭" />
      </view>

      <view class="manual-meal-section">
        <view class="manual-meal-header">
          <text class="manual-meal-emoji">🌙</text>
          <text class="manual-meal-name" style="font-size: {{28 * fontScale}}rpx;">晚餐</text>
          <text wx:if="{{manualForm.dinner}}" class="manual-meal-count" style="font-size: {{20 * fontScale}}rpx;">已填</text>
        </view>
        <input class="manual-meal-input" value="{{manualForm.dinner}}" bindinput="onManualField" data-field="dinner" placeholder="例：番茄蛋汤,清炒时蔬" />
      </view>

      <view class="manual-actions">
        <view class="btn-secondary manual-cancel" catchtap="closeManualLog">取消</view>
        <view class="btn-secondary manual-logbook" catchtap="onOpenLogbook">📋 查看记录本</view>
        <view class="btn-primary manual-save" catchtap="onManualSave" hover-class="btn-primary-hover">保存记录</view>
      </view>
    </view>
  </view>

  <!-- 手动记录本 modal（点「查看记录本」触发） -->
  <view wx:if="{{showLogbook}}" class="logbook-mask" catchtap="closeLogbook">
    <view class="logbook-card" catchtap="">
      <view class="logbook-header">
        <text class="logbook-emoji" style="font-size: {{64 * fontScale}}rpx;">📋</text>
        <view class="logbook-title-block">
          <view class="logbook-title" style="font-size: {{32 * fontScale}}rpx;">手动记录本</view>
          <view class="logbook-sub" style="font-size: {{22 * fontScale}}rpx;">最近的吃食记录（手动 + 抽签）</view>
        </view>
        <view class="logbook-close" catchtap="closeLogbook">✕</view>
      </view>

      <scroll-view scroll-y class="logbook-scroll">
        <view wx:if="{{logbookLoading}}" class="logbook-loading">加载中…</view>
        <view wx:elif="{{logbookGroups.length === 0}}" class="logbook-empty">还没有记录</view>
        <block wx:else>
          <block wx:for="{{logbookGroups}}" wx:key="date" wx:for-item="g">
            <view class="logbook-date" style="font-size: {{26 * fontScale}}rpx;">📅 {{g.date}}</view>
            <block wx:for="{{g.items}}" wx:key="_id" wx:for-item="r">
              <view class="logbook-row" data-id="{{r._id}}" data-idx="{{index}}" bindtap="onEditRecord" hover-class="logbook-row-hover">
                <view class="logbook-row-left">
                  <text class="logbook-row-badge">{{r.statusLabel}}</text>
                  <text class="logbook-row-meal">{{r.mealEmoji}}</text>
                  <text class="logbook-row-dish">{{r.dish}}</text>
                </view>
                <view class="logbook-row-actions">
                  <view class="logbook-row-action" data-id="{{r._id}}" catchtap="onEditLogItem">✏️</view>
                  <view class="logbook-row-action" data-id="{{r._id}}" catchtap="onDeleteLogItem">🗑</view>
                </view>
              </view>
            </block>
          </block>
        </block>
      </scroll-view>
    </view>
  </view>

  <!-- 编辑某条记录 modal -->
  <view wx:if="{{showEditRecord}}" class="edit-mask" catchtap="closeEditRecord">
    <view class="edit-card" catchtap="">
      <view class="edit-header">
        <view class="edit-title" style="font-size: {{32 * fontScale}}rpx;">编辑记录</view>
        <view class="edit-close" catchtap="closeEditRecord">✕</view>
      </view>
      <view class="edit-section">
        <view class="edit-label" style="font-size: {{26 * fontScale}}rpx;">🍱 菜名</view>
        <input class="edit-input" value="{{editForm.dish}}" bindinput="onEditField" data-field="dish" />
      </view>
      <view class="edit-section">
        <view class="edit-label" style="font-size: {{26 * fontScale}}rpx;">⏰ 类型</view>
        <view class="edit-meal-row">
          <view class="edit-meal-chip {{editForm.meal === '早餐' ? 'on' : ''}}" data-meal="早餐" catchtap="onEditMeal">☀️ 早餐</view>
          <view class="edit-meal-chip {{editForm.meal === '午餐' ? 'on' : ''}}" data-meal="午餐" catchtap="onEditMeal">🌞 午餐</view>
          <view class="edit-meal-chip {{editForm.meal === '晚餐' ? 'on' : ''}}" data-meal="晚餐" catchtap="onEditMeal">🌙 晚餐</view>
        </view>
      </view>
      <view class="edit-actions">
        <view class="btn-secondary" catchtap="closeEditRecord">取消</view>
        <view class="btn-primary" catchtap="onSaveEdit" hover-class="btn-primary-hover">保存</view>
      </view>
    </view>
  </view>

  <!-- Onboarding modal：首次进入弹 -->
  <view wx:if="{{showOnboarding}}" class="onboard-mask">
    <view class="onboard-card">
      <view class="onboard-title" style="font-size: {{34 * fontScale}}rpx;">挑你会做的菜</view>
      <view class="onboard-sub" style="font-size: {{24 * fontScale}}rpx;">从 125 道家常菜里勾选，可跳过</view>
      <scroll-view scroll-y class="onboard-scroll">
        <block wx:for="{{onboardingDishes}}" wx:key="role" wx:for-item="group">
          <view class="onboard-group">
            <view class="onboard-group-header">
              <view class="onboard-group-title" style="font-size: {{26 * fontScale}}rpx;">{{group.label}}</view>
              <view class="onboard-group-actions">
                <view class="onboard-mini-btn"
                      style="font-size: {{22 * fontScale}}rpx;"
                      data-role="{{group.role}}"
                      bindtap="onSelectGroup">全选</view>
                <view class="onboard-mini-btn onboard-mini-btn-clear"
                      style="font-size: {{22 * fontScale}}rpx;"
                      data-role="{{group.role}}"
                      bindtap="onClearGroup">清除</view>
              </view>
            </view>
            <view class="onboard-grid">
              <block wx:for="{{group.items}}" wx:key="*this" wx:for-item="item">
                <view class="onboard-item {{item.checked ? 'onboard-item-on' : ''}}"
                      style="font-size: {{24 * fontScale}}rpx;"
                      data-role="{{group.role}}"
                      data-name="{{item.name}}"
                      bindtap="onToggleOnboard">
                  {{item.checked ? '✓ ' : ''}}{{item.name}}
                </view>
              </block>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="onboard-actions">
        <view class="btn-secondary" bindtap="closeOnboarding">跳过</view>
        <view class="btn-primary" bindtap="saveOnboarding">保存</view>
      </view>
    </view>
  </view>

</view>
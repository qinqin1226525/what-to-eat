<!-- pages/home/home.wxml —— 手搓选菜（主页）
     UI 纪律：低饱和、无动画、单屏不滚动（带孩子场景）
-->
<view class="home">

  <!-- 顶部问候 -->
  <view class="home-header">
    <view class="home-title" style="font-size: {{36 * fontScale}}rpx;">今天吃什么</view>
    <view class="home-sub" style="font-size: {{24 * fontScale}}rpx;">
      <text wx:if="{{loading}}">加载中…</text>
      <text wx:elif="{{customDishes.length === 0}}">先告诉我你会做哪些菜</text>
      <text wx:else>菜池 {{customDishes.length}} 道 · 冰箱 {{fridgeItems.length}} 项</text>
    </view>
  </view>

  <!-- 冰箱 chip 行（带输入框 + 删除 ×） -->
  <view class="section">
    <view class="section-label" style="font-size: {{22 * fontScale}}rpx;">
      <text>🥬 冰箱</text>
      <text wx:if="{{fridgeItems.length > 0}}" class="fridge-clear-link" style="font-size: {{20 * fontScale}}rpx;" catchtap="onFridgeClear">清空</text>
    </view>
    <view class="fridge-input-row">
      <input class="fridge-input" value="{{fridgeInput}}" bindinput="onFridgeInput"
             bindconfirm="onFridgeAdd" placeholder="输入食材，逗号分隔…" confirm-type="done" />
      <view class="fridge-add-btn {{savingFridge ? 'disabled' : ''}}" catchtap="onFridgeAdd">加</view>
    </view>
    <scroll-view scroll-x wx:if="{{fridgeItems.length > 0}}" class="chip-scroll" enhanced show-scrollbar="{{false}}">
      <block wx:for="{{fridgeItems}}" wx:key="*this">
        <view class="chip chip-fridge" style="font-size: {{24 * fontScale}}rpx;" data-name="{{item}}" catchtap="onFridgeRemove">{{item}}<text class="chip-x">×</text></view>

      </scroll-view>
  </view>

  <!-- 菜池 chip 行（可加可删） -->
  <view class="section">
    <view class="section-label" style="font-size: {{22 * fontScale}}rpx;">🍳 我会做的</view>
    <scroll-view scroll-x class="chip-scroll" enhanced show-scrollbar="{{false}}">
      <block wx:for="{{customDishes}}" wx:key="*this">
        <view class="chip chip-custom" style="font-size: {{24 * fontScale}}rpx;" data-name="{{item}}" bindtap="onRemoveDish">
          {{item}}<text class="chip-x">×</text>
        </view>
      </block>
      <!-- 加菜输入 -->
      <view class="chip chip-add" style="font-size: {{24 * fontScale}}rpx;">
        <input class="chip-input" placeholder="+ 加菜" placeholder-class="chip-input-ph" bindconfirm="onAddDish" confirm-type="done" />
      </view>
    </scroll-view>
  </view>

  <!-- 操作区 -->
  <view class="actions">
    <view class="btn-primary big-btn" catchtap="onRandomPick" hover-class="btn-primary-hover">
      <text wx:if="{{picking}}">选菜中…</text>
      <text wx:else>🎲 帮我选 3 道</text>
    </view>
    <view class="btn-primary big-btn" catchtap="onFridgeRecommend" hover-class="btn-primary-hover">
      🥬 冰箱有什么 → 做啥菜
    </view>
    <view class="btn-primary big-btn" catchtap="onManualRecord" hover-class="btn-primary-hover">
      📝 手动记录今天吃了啥
    </view>
    <view class="btn-secondary small-btn" catchtap="onAiInspire" hover-class="btn-primary-hover">
      🤖 AI 顾问
    </view>
  </view>

  <!-- 最近选了 -->
  <view class="recent" wx:if="{{recentPicks.length > 0}}">
    <view class="recent-label" style="font-size: {{22 * fontScale}}rpx;">最近 7 天吃过</view>
    <view class="recent-list" style="font-size: {{24 * fontScale}}rpx;">
      <text wx:for="{{recentPicks}}" wx:key="*this" class="recent-item">{{item}}</text>
    </view>
  </view>

  <!-- 抽到结果：全屏 modal -->
  <view wx:if="{{picked}}" class="result-mask" bindtap="closePicked">
    <view class="result-card" catchtap="_noop">
      <view class="result-close" bindtap="closePicked">✕</view>
      <view class="result-title" style="font-size: {{32 * fontScale}}rpx;">
        <block wx:if="{{picked.source === 'ai'}}">🤖 AI 顾问</block>
        <block wx:elif="{{picked.source === 'fridge'}}">🥬 冰箱有什么</block>
        <block wx:else>🎲 今日推荐</block>
      </view>
      <view wx:if="{{pickedHint}}" class="result-hint" style="font-size: {{22 * fontScale}}rpx;">{{pickedHint}}</view>
      <view wx:if="{{pickedMeals.length > 0}}" class="picked-hint" style="font-size: {{22 * fontScale}}rpx;">✓ 已选 {{pickedMeals.length}} 道：{{pickedMeals.join('、')}}</view>
      <block wx:for="{{picked.dishes}}" wx:key="*this" wx:for-item="dish" wx:for-index="idx">
        <view wx:if="{{picked.dishInfos && picked.dishInfos[idx]}}">
          <!-- 左侧：emoji + 菜名（带 › 展开符号）+ role·时间 -->
          <view class="result-row-main">
            <view class="result-emoji" style="font-size: {{48 * fontScale}}rpx;">{{picked.dishInfos[idx].emoji}}</view>
            <view class="result-info">
              <view class="result-dish-line" data-idx="{{idx}}" catchtap="onToggleExpand" hover-class="result-dish-line-hover">
                <text class="result-dish" style="font-size: {{34 * fontScale}}rpx;">{{dish}}</text>
                <view class="result-toggle">
                  <text wx:if="{{picked.expanded && picked.expanded[idx]}}" style="font-size: {{28 * fontScale}}rpx;">▼</text>
                  <text wx:else style="font-size: {{28 * fontScale}}rpx;">›</text>
                </view>
              </view>
              <view class="result-meta" style="font-size: {{22 * fontScale}}rpx;">
                {{picked.dishInfos[idx].role}} · 约 {{picked.dishInfos[idx].time}} 分钟
              </view>
              <view wx:if="{{picked.reasons && picked.reasons[idx] && picked.reasons[idx].reason}}" class="result-reason" style="font-size: {{22 * fontScale}}rpx;">
                💡 {{picked.reasons[idx].reason}}
              </view>
            </view>
          </view>

          <!-- 展开：步骤 + 小贴士（点 › 触发） -->
          <view wx:if="{{picked.expanded && picked.expanded[idx]}}" class="result-expand">
            <block wx:if="{{picked.dishInfos[idx].ingredients && picked.dishInfos[idx].ingredients.length > 0}}">
              <view class="result-expand-section" style="font-size: {{24 * fontScale}}rpx;">
                <text class="result-expand-label">食材：</text>
                <text class="result-expand-text">{{picked.dishInfos[idx].ingredientsStr}}</text>
              </view>
            </block>
            <block wx:if="{{picked.dishInfos[idx].seasonings && picked.dishInfos[idx].seasonings.length > 0}}">
              <view class="result-expand-section" style="font-size: {{24 * fontScale}}rpx;">
                <text class="result-expand-label">调料：</text>
                <text class="result-expand-text">{{picked.dishInfos[idx].seasoningsStr}}</text>
              </view>
            </block>
            <block wx:if="{{picked.dishInfos[idx].steps && picked.dishInfos[idx].steps.length > 0}}">
              <view class="result-expand-title" style="font-size: {{24 * fontScale}}rpx;">做法</view>
              <block wx:for="{{picked.dishInfos[idx].steps}}" wx:key="*this" wx:for-item="step" wx:for-index="sidx">
                <view class="result-expand-step" style="font-size: {{24 * fontScale}}rpx;">
                  <text class="result-step-num">{{sidx + 1}}.</text>
                  <text>{{step}}</text>
                </view>
            </view>
          </view>

          <!-- 右侧：4 个按钮垂直 -->
          <view class="result-row-buttons">
            <view class="result-btn {{pickedMeals.indexOf(dish) >= 0 ? 'result-btn-eat-done' : 'result-btn-eat'}}"
                  style="font-size: {{24 * fontScale}}rpx;" data-dish="{{dish}}" catchtap="onEat">
              <block wx:if="{{pickedMeals.indexOf(dish) >= 0}}">✓ 已选</block>
              <block wx:else>✓ 选这道</block>
            </view>
            <view class="result-btn result-btn-swap" style="font-size: {{24 * fontScale}}rpx;" data-idx="{{idx}}" catchtap="onSwapDish">🔄 换一道</view>
            <view class="result-btn result-btn-custom" style="font-size: {{24 * fontScale}}rpx;" data-idx="{{idx}}" catchtap="onCustomDish">🍽 别的</view>
            <view class="result-btn result-btn-skip" style="font-size: {{24 * fontScale}}rpx;" data-idx="{{idx}}" catchtap="onSkip">✕ 跳过</view>
          </view>
        </view>
      </block>

      <!-- 底部：再来一道 chip 行 + 就做这些主按钮 -->
      <view class="result-footer">
        <view class="footer-label" style="font-size: {{22 * fontScale}}rpx;">➕ 再来一道</view>
        <view class="role-add-row">
          <view class="role-add-chip" data-role="主菜" catchtap="addMoreDish">🍖 主菜</view>
          <view class="role-add-chip" data-role="汤" catchtap="addMoreDish">🥣 汤</view>
          <view class="role-add-chip" data-role="主食" catchtap="addMoreDish">🍚 主食</view>
          <view class="role-add-chip" data-role="凉菜" catchtap="addMoreDish">🥗 凉菜</view>
        </view>
        <view class="result-btn-finish {{pickedMeals.length === 0 ? 'result-btn-finish-disabled' : ''}}"
              catchtap="finishEat" style="font-size: {{30 * fontScale}}rpx;">
          <block wx:if="{{pickedMeals.length === 0}}">👆 选几道菜再点这个</block>
          <block wx:elif="{{pickedMeals.length === 1}}">✅ 就做 {{pickedMeals[0]}}</block>
          <block wx:else>✅ 就做这些（{{pickedMeals.length}} 道）</block>
        </view>
      </view>
    </view>
  </view>

  <!-- 「别的」modal：手动输入菜名 + 模糊查询 -->
  <view wx:if="{{showCustomDish}}" class="custom-mask" bindtap="closeCustomDish">
    <view class="custom-card" catchtap="">
      <view class="custom-title" style="font-size: {{32 * fontScale}}rpx;">换个别的</view>
      <view class="custom-sub" style="font-size: {{22 * fontScale}}rpx;">输入菜名，或从下方候选里挑</view>
      <input class="custom-input" value="{{customInput}}" bindinput="onCustomInput"
             bindconfirm="onCustomConfirm" confirm-type="done" placeholder="输入菜名…" focus="{{customFocus}}" />
      <view wx:if="{{customCandidates.length > 0}}" class="custom-candidates">
        <view class="custom-candidates-title" style="font-size: {{22 * fontScale}}rpx;">从菜池里匹配（{{customCandidates.length}}）</view>
        <block wx:for="{{customCandidates}}" wx:key="*this">
          <view class="custom-candidate" style="font-size: {{28 * fontScale}}rpx;" data-name="{{item}}" bindtap="onPickCandidate">{{item}}</view>
        </block>
      </view>
      <view wx:elif="{{customInput}}">
        <view class="custom-add-new" style="font-size: {{26 * fontScale}}rpx;" bindtap="onCustomConfirm">
          ➕ 添加「{{customInput}}」到菜池
        </view>
      </view>
      <view class="custom-actions">
        <view class="btn-secondary" bindtap="closeCustomDish">取消</view>
      </view>
    </view>
  </view>

  <!-- 手动记录 modal（按饮食报告风格：温暖米色 + 卡片化） -->
  <view wx:if="{{showManualLog}}" class="manual-mask" catchtap="closeManualLog">
    <view class="manual-card" catchtap="">
      <view class="manual-header">
        <view class="manual-icon">📝</view>
        <view class="manual-title" style="font-size: {{32 * fontScale}}rpx;">{{manualForm.date}} · 手动记录</view>
        <view class="manual-close" catchtap="closeManualLog">✕</view>
      </view>
      <view class="manual-meta" style="font-size: {{22 * fontScale}}rpx;">多个菜用逗号分隔 · 可只填一餐</view>

      <!-- 日期选择器 -->
      <view class="manual-date-card" catchtap="onManualDateTap">
        <text class="manual-date-label" style="font-size: {{22 * fontScale}}rpx;">📅 日期</text>
        <picker mode="date" value="{{manualForm.date}}" bindchange="onManualField" data-field="date">
          <view class="manual-date-value" style="font-size: {{28 * fontScale}}rpx;">{{manualForm.date}}</view>
        </picker>
      </view>

      <!-- 3 段：早/午/晚 -->
      <view class="manual-meal-section">
        <view class="manual-meal-header">
          <text class="manual-meal-emoji">☀️</text>
          <text class="manual-meal-name" style="font-size: {{28 * fontScale}}rpx;">早餐</text>
          <text wx:if="{{manualForm.breakfast}}" class="manual-meal-count" style="font-size: {{20 * fontScale}}rpx;">已填</text>
        </view>
        <input class="manual-meal-input" value="{{manualForm.breakfast}}" bindinput="onManualField" data-field="breakfast" placeholder="例：面包,牛奶" />
      </view>

      <view class="manual-meal-section">
        <view class="manual-meal-header">
          <text class="manual-meal-emoji">🌞</text>
          <text class="manual-meal-name" style="font-size: {{28 * fontScale}}rpx;">午餐</text>
          <text wx:if="{{manualForm.lunch}}" class="manual-meal-count" style="font-size: {{20 * fontScale}}rpx;">已填</text>
        </view>
        <input class="manual-meal-input" value="{{manualForm.lunch}}" bindinput="onManualField" data-field="lunch" placeholder="例：宫保鸡丁,米饭" />
      </view>

      <view class="manual-meal-section">
        <view class="manual-meal-header">
          <text class="manual-meal-emoji">🌙</text>
          <text class="manual-meal-name" style="font-size: {{28 * fontScale}}rpx;">晚餐</text>
          <text wx:if="{{manualForm.dinner}}" class="manual-meal-count" style="font-size: {{20 * fontScale}}rpx;">已填</text>
        </view>
        <input class="manual-meal-input" value="{{manualForm.dinner}}" bindinput="onManualField" data-field="dinner" placeholder="例：番茄蛋汤,清炒时蔬" />
      </view>

      <view class="manual-actions">
        <view class="btn-secondary manual-cancel" catchtap="closeManualLog">取消</view>
        <view class="btn-primary manual-save" catchtap="onManualSave" hover-class="btn-primary-hover">保存记录</view>
      </view>
    </view>
  </view>

  <!-- Onboarding modal：首次进入弹 -->
  <view wx:if="{{showOnboarding}}" class="onboard-mask">
    <view class="onboard-card">
      <view class="onboard-title" style="font-size: {{34 * fontScale}}rpx;">挑你会做的菜</view>
      <view class="onboard-sub" style="font-size: {{24 * fontScale}}rpx;">从 125 道家常菜里勾选，可跳过</view>
      <scroll-view scroll-y class="onboard-scroll">
        <block wx:for="{{onboardingDishes}}" wx:key="role" wx:for-item="group">
          <view class="onboard-group">
            <view class="onboard-group-header">
              <view class="onboard-group-title" style="font-size: {{26 * fontScale}}rpx;">{{group.label}}</view>
              <view class="onboard-group-actions">
                <view class="onboard-mini-btn"
                      style="font-size: {{22 * fontScale}}rpx;"
                      data-role="{{group.role}}"
                      bindtap="onSelectGroup">全选</view>
                <view class="onboard-mini-btn onboard-mini-btn-clear"
                      style="font-size: {{22 * fontScale}}rpx;"
                      data-role="{{group.role}}"
                      bindtap="onClearGroup">清除</view>
              </view>
            </view>
            <view class="onboard-grid">
              <block wx:for="{{group.items}}" wx:key="*this" wx:for-item="item">
                <view class="onboard-item {{item.checked ? 'onboard-item-on' : ''}}"
                      style="font-size: {{24 * fontScale}}rpx;"
                      data-role="{{group.role}}"
                      data-name="{{item.name}}"
                      bindtap="onToggleOnboard">
                  {{item.checked ? '✓ ' : ''}}{{item.name}}
                </view>
              </block>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="onboard-actions">
        <view class="btn-secondary" bindtap="closeOnboarding">跳过</view>
        <view class="btn-primary" bindtap="saveOnboarding">保存</view>
      </view>
    </view>
  </view>

</view>
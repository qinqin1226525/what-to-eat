/* pages/home/home.wxss —— 对齐 web app 风格
   配色：暖色 banner + 米色卡片 + 橙色主题
*/

.home {
  min-height: 100vh;
  background: #fafaf7;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ========== 橙色 banner ========== */
.header-banner {
  background: linear-gradient(135deg, #ff9a3c, #ff6b35);
  color: #fff;
  padding: 32rpx 32rpx 24rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.header-top-left {
  flex: 1;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.header-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.banner-actions {
  display: flex;
  gap: 16rpx;
}

.banner-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  color: #ff9a3c;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.banner-btn:active {
  background: #fff;
  transform: scale(0.97);
}

.banner-btn-primary {
  background: #fff;
  color: #ff9a3c;
  font-weight: 700;
}

/* ========== 搜索框 ========== */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx 32rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  color: #999;
  font-size: 32rpx;
  padding: 0 8rpx;
}

.search-results {
  background: #fff;
  margin: 0 32rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-result-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #fafaf7;
}

.search-result-hover {
  background: #fafaf7;
}

.search-result-emoji {
  margin-right: 16rpx;
}

.search-result-info { flex: 1; min-width: 0; }

.search-result-name {
  font-weight: 600;
  color: #2a2a2a;
  margin-bottom: 4rpx;
}

.search-result-meta { color: #999; }

.search-result-arrow {
  color: #ccc;
  font-size: 36rpx;
  font-weight: 300;
}

/* ========== 4 mode tabs ========== */
.mode-tabs {
  display: flex;
  gap: 8rpx;
  margin: 0 32rpx 20rpx;
  background: #fff;
  padding: 8rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
  color: #888;
  border-radius: 12rpx;
  font-weight: 500;
}

.mode-tab.active {
  background: linear-gradient(135deg, #ff9a3c, #e88a30);
  color: #fff;
  font-weight: 600;
}

.mode-tab:active {
  opacity: 0.7;
}

/* ========== 模式面板 ========== */
.mode-panel {
  margin: 0 32rpx;
}

.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.big-btn {
  display: block;
  background: linear-gradient(135deg, #ff9a3c, #e88a30);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 60, 0.3);
}

.big-btn.small {
  display: inline-block;
  width: auto;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 0;
  margin-left: 16rpx;
  flex: 1;
}

.big-btn:active { opacity: 0.85; }

.empty-hint {
  text-align: center;
  color: #aaa;
  padding: 40rpx 0;
  font-size: 26rpx;
}

.result-area {
  min-height: 80rpx;
}

/* ========== 菜卡片（抽一套结果）============ */
.dish-card {
  background: #fafaf7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.dish-card-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.dish-emoji {
  flex-shrink: 0;
  line-height: 1;
}

.dish-info { flex: 1; min-width: 0; }

.dish-name {
  font-weight: 600;
  color: #2a2a2a;
  margin-bottom: 4rpx;
}

.dish-meta { color: #999; }

.dish-toggle {
  color: #ff9a3c;
  font-weight: 600;
  flex-shrink: 0;
  padding: 0 12rpx;
}

.dish-actions {
  display: flex;
  gap: 12rpx;
}

.dish-act {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.dish-act-eat {
  background: #2da44e;
  color: #fff;
  border: 2rpx solid #2da44e;
}

.dish-act-eat:active { background: #258a42; }

.dish-act-swap {
  background: #fff;
  color: #3b82f6;
  border: 2rpx solid #3b82f6;
}

.dish-act-skip {
  background: #fff;
  color: #d14545;
  border: 2rpx solid #d14545;
}

/* ========== 三餐 section ========== */
.meal-section {
  background: #fafaf7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.meal-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #fff;
}

.meal-emoji { font-size: 28rpx; }

.meal-name {
  font-weight: 600;
  color: #2a2a2a;
}

.dish-mini-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.dish-mini-emoji { font-size: 24rpx; margin-right: 8rpx; }

.dish-mini-name { color: #2a2a2a; }

.meal-dish-card {
  background: #fff;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
  margin-bottom: 8rpx;
  border: 2rpx solid #f5ebe0;
}

.meal-dish-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.meal-dish-info { flex: 1; min-width: 0; }

.meal-dish-name {
  font-weight: 600;
  color: #2a2a2a;
  margin-bottom: 2rpx;
}

.meal-dish-meta { color: #999; }

.meal-sub {
  color: #999;
  margin-left: auto;
}

.dish-act-custom {
  background: #fff;
  color: #ff9a3c;
  border: 2rpx solid #ff9a3c;
}

.all-eat-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #ff9a3c, #e88a30);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* ========== 冰箱输入 ========== */
.fridge-input-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.fridge-input {
  flex: 1;
  background: #fafaf7;
  border: 2rpx solid #f0ebe0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-width: 0;
}

.fridge-input:focus { border-color: #ff9a3c; }

/* ========== 通用 modal 样式 ========== */
.recipe-mask, .manual-mask, .report-mask, .ai-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 32rpx;
  box-sizing: border-box;
}

.recipe-card, .manual-card, .report-card, .ai-card {
  background: #fafaf7;
  border-radius: 20rpx;
  padding: 24rpx;
  width: 100%;
  max-width: 680rpx;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  position: relative;
}

.modal-close {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 36rpx;
  z-index: 2;
}

/* ========== 菜谱详情 modal ========== */
.recipe-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
}

.recipe-emoji {
  margin-right: 12rpx;
  line-height: 1;
  flex-shrink: 0;
}

.recipe-title {
  font-weight: 700;
  color: #2a2a2a;
  margin-bottom: 4rpx;
}

.recipe-meta { color: #888; }

.recipe-scroll {
  flex: 1;
  overflow-y: auto;
  max-height: 60vh;
}

.recipe-section {
  margin-bottom: 16rpx;
}

.recipe-section-title {
  color: #5a5a5a;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.recipe-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.recipe-tag {
  background: #fff5e6;
  color: #b8702c;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.recipe-step {
  display: flex;
  line-height: 1.6;
  margin-bottom: 4rpx;
  color: #444;
}

.recipe-step-num {
  color: #ff9a3c;
  font-weight: 600;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.recipe-step-text { flex: 1; }

.recipe-tip {
  color: #8a6d3b;
  background: #fff8eb;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ========== 手动记录 modal ========== */
.manual-title {
  font-weight: 700;
  color: #2a2a2a;
  margin-bottom: 4rpx;
}

.manual-meta {
  color: #999;
  margin-bottom: 20rpx;
}

.manual-date-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.manual-date-label { color: #999; }
.manual-date-value { color: #2a2a2a; font-weight: 500; }

.manual-meal-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.manual-meal-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.manual-meal-name { color: #2a2a2a; font-weight: 500; }

.manual-meal-input {
  background: #fafaf7;
  border: 2rpx solid #f0ebe0;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.manual-meal-input:focus { border-color: #ff9a3c; }

.manual-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-secondary {
  flex: 1;
  background: #fff;
  border: 2rpx solid #f0ebe0;
  border-radius: 12rpx;
  padding: 18rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.btn-primary {
  flex: 2;
  background: linear-gradient(135deg, #ff9a3c, #e88a30);
  color: #fff;
  border-radius: 12rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary:active { opacity: 0.85; }

/* ========== 月度报告 modal ========== */
.report-icon {
  text-align: center;
  font-size: 80rpx;
  margin-bottom: 8rpx;
}

.report-title {
  text-align: center;
  font-weight: 700;
  color: #2a2a2a;
  margin-bottom: 4rpx;
}

.report-sub {
  text-align: center;
  color: #999;
  margin-bottom: 20rpx;
}

.report-stats {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.report-stat {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.report-num {
  color: #ff9a3c;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 4rpx;
  background: linear-gradient(180deg, #ff9a3c, #e85d04);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.report-num-green {
  background: linear-gradient(180deg, #4ade80, #2da44e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.report-num-purple {
  background: linear-gradient(180deg, #c084fc, #8b5cf6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.report-label { color: #888; }

.report-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.report-section-title {
  color: #5a5a5a;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.report-top-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.report-top-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fff;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.report-top-name {
  flex: 1;
  color: #2a2a2a;
  font-weight: 500;
}

.report-top-count { color: #999; }

.report-meal-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  gap: 12rpx;
}

.report-meal-label {
  color: #2a2a2a;
  font-weight: 500;
  width: 70rpx;
  flex-shrink: 0;
}

.report-meal-bar-wrap {
  flex: 1;
  height: 14rpx;
  background: #f0f0f0;
  border-radius: 999rpx;
  overflow: hidden;
}

.report-meal-bar {
  height: 100%;
  border-radius: 999rpx;
}

.report-meal-count {
  color: #999;
  width: 40rpx;
  text-align: right;
  flex-shrink: 0;
}

/* ========== AI 顾问 modal ========== */
.ai-title {
  font-weight: 700;
  color: #2a2a2a;
  margin-bottom: 4rpx;
}

.ai-sub {
  color: #999;
  margin-bottom: 20rpx;
}

.ai-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.ai-entry:active { background: #fff5e6; }

.ai-entry-emoji { font-size: 40rpx; }

.ai-entry-info { flex: 1; }

.ai-entry-title {
  font-weight: 600;
  color: #2a2a2a;
  margin-bottom: 2rpx;
}

.ai-entry-sub { color: #888; }

.ai-entry-arrow { color: #ff9a3c; font-size: 32rpx; }

.logbook-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 180;
  padding: 32rpx;
  box-sizing: border-box;
}

.logbook-card {
  background: #fafaf7;
  border-radius: 20rpx;
  padding: 24rpx;
  width: 100%;
  max-width: 680rpx;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.logbook-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
}

.logbook-emoji {
  font-size: 60rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.logbook-title-block { flex: 1; min-width: 0; }

.logbook-title {
  font-weight: 700;
  color: #2a2a2a;
  margin-bottom: 4rpx;
}

.logbook-sub {
  color: #888;
}

.logbook-close {
  position: absolute;
  top: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 36rpx;
}

.logbook-scroll {
  flex: 1;
  overflow-y: auto;
  max-height: 65vh;
}

.logbook-loading,
.logbook-empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}

.logbook-date {
  color: #5a5a5a;
  font-weight: 600;
  padding: 20rpx 0 12rpx;
  border-bottom: 2rpx solid #f0ebe0;
  margin-bottom: 8rpx;
}

.logbook-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.03);
}

.logbook-row-hover {
  background: #fafaf7;
}

.logbook-row-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.logbook-row-badge {
  font-size: 22rpx;
  color: #2da44e;
  background: #e8f7ed;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.logbook-row-meal {
  font-size: 28rpx;
  flex-shrink: 0;
}

.logbook-row-dish {
  color: #2a2a2a;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.logbook-row-actions {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.logbook-row-action {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 12rpx;
  background: #fafaf7;
}

.logbook-row-action:active {
  background: #fff5e6;
}

/* ===== 编辑记录 modal ===== */
.edit-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 32rpx;
  box-sizing: border-box;
}

.edit-card {
  background: #fafaf7;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  width: 100%;
  max-width: 640rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.edit-title {
  font-weight: 700;
  color: #2a2a2a;
}

.edit-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 36rpx;
}

.edit-section {
  margin-bottom: 20rpx;
}

.edit-label {
  color: #5a5a5a;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.edit-input {
  background: #fff;
  border: 2rpx solid #f0ebe0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.edit-input:focus {
  border-color: #ff9a3c;
}

.edit-meal-row {
  display: flex;
  gap: 12rpx;
}

.edit-meal-chip {
  flex: 1;
  background: #fff;
  border: 2rpx solid #f0ebe0;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  color: #5a5a5a;
  font-size: 26rpx;
}

.edit-meal-chip.on {
  background: linear-gradient(135deg, #fff5e6, #ffe4c4);
  border-color: #ff9a3c;
  color: #2a2a2a;

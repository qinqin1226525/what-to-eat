/* pages/home/home.wxss —— 手搓选菜
   配色纪律：低饱和、米色/灰白为主、品牌色仅 1 处橙色
   无动画、无圆点 loading、无大字 emoji（防吸引孩子）
*/

.home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #fafaf7;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  /* v2 NFR-3 单页不滚动，但菜池/最近吃过多时内容溢出 → 允许纵向滚动 */
  overflow-y: auto;
}

/* 顶部 */
.home-header {
  padding: 16rpx 0 24rpx;
  flex-shrink: 0;
}

.home-title {
  font-weight: 600;
  color: #2a2a2a;
  margin-bottom: 6rpx;
}

.home-sub {
  color: #999;
}

/* Section（chip 行） */
.section {
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.section-label {
  color: #888;
  margin-bottom: 10rpx;
}

.chip-scroll {
  white-space: nowrap;
  width: 100%;
}

/* chip */
.chip {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  line-height: 1.4;
}

.chip-fridge {
  background: #f0f4ed;
  color: #5a7a4a;
}

.chip-custom {
  background: #fff5e6;
  color: #b8702c;
}

.chip-x {
  margin-left: 8rpx;
  color: #c8966a;
  font-weight: 300;
}

.chip-add {
  background: #fff;
  border: 2rpx dashed #ddd;
  padding: 8rpx 20rpx;
}

.chip-input {
  display: inline-block;
  width: 120rpx;
  font-size: inherit;
  color: #999;
}

.chip-input-ph {
  color: #ccc;
}

/* 操作按钮 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 0 24rpx;
  flex-shrink: 0;
}

.big-btn {
  font-size: 32rpx;
  padding: 28rpx 0;
}

.small-btn {
  font-size: 26rpx;
  padding: 18rpx 0;
}

/* 最近选了 */
.recent {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  flex-shrink: 0;
}

.recent-label {
  color: #888;
  margin-bottom: 10rpx;
}

.recent-list {
  color: #666;
  line-height: 1.6;
}

.recent-item {
  margin-right: 12rpx;
}

/* ===== 结果 modal ===== */
.result-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
  box-sizing: border-box;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  width: 100%;
  max-width: 640rpx;
  max-height: 85vh;     /* 限制 modal 高度，避免展开多道菜时撑爆屏幕 */
  overflow-y: auto;       /* 内容溢出时 modal 内部纵向滚动 */
  position: relative;
}

.result-close {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  color: #999;
  font-size: 32rpx;
  width: 48rpx;
  height: 48rpx;
  text-align: center;
  line-height: 48rpx;
}

.result-title {
  font-weight: 600;
  color: #2a2a2a;
  margin-bottom: 24rpx;
}

.result-hint {
  color: #999;
  margin-bottom: 16rpx;
  font-style: italic;
}

.result-row-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0 12rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.result-emoji {
  flex-shrink: 0;
  line-height: 1;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-dish-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
  padding: 4rpx 0;
}

.result-dish-line-hover {
  opacity: 0.6;
}

.result-dish {
  font-weight: 600;
  color: #2a2a2a;
}

.result-toggle {
  color: #ff9a3c;
  font-weight: 600;
  flex-shrink: 0;
  padding: 0 8rpx;
}

.result-meta {
  color: #888;
  margin-bottom: 4rpx;
}

.result-reason {
  color: #999;
  font-style: italic;
}

/* ===== 展开做法 ===== */
.result-expand {
  background: #fafaf7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin: 8rpx 0 12rpx;
}

.result-expand-section {
  line-height: 1.6;
  margin-bottom: 6rpx;
  color: #555;
  word-break: break-all;
}

.result-expand-label {
  color: #999;
  font-weight: 500;
}

.result-expand-text {
  color: #444;
}

.result-expand-title {
  color: #5a5a5a;
  font-weight: 600;
  margin: 10rpx 0 6rpx;
}

.result-expand-step {
  display: flex;
  line-height: 1.6;
  margin-bottom: 4rpx;
  color: #444;
}

.result-step-num {
  color: #ff9a3c;
  font-weight: 600;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.result-tip {
  color: #8a6d3b;
  background: #fff8eb;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  margin-top: 10rpx;
  line-height: 1.5;
}

.result-row-buttons {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 12rpx 0 16rpx;
}

.result-btn {
  display: block;
  text-align: center;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

/* ✓ 就做 — 绿色实心 */
.result-btn-eat {
  background: #2da44e;
  color: #fff;
  border: 2rpx solid #2da44e;
}

.result-btn-eat:active {
  background: #258a42;
}

/* 🔄 换一道 — 蓝色边框 */
.result-btn-swap {
  background: #fff;
  color: #3b82f6;
  border: 2rpx solid #3b82f6;
}

.result-btn-swap:active {
  background: #f0f5ff;
}

/* 🍽 别的 — 橙色边框（跟品牌色一致）*/
.result-btn-custom {
  background: #fff;
  color: #ff9a3c;
  border: 2rpx solid #ff9a3c;
}

.result-btn-custom:active {
  background: #fff5e6;
}

/* ✕ 跳过 — 红色边框 */
.result-btn-skip {
  background: #fff;
  color: #d14545;
  border: 2rpx solid #d14545;
}

.result-btn-skip:active {
  background: #fde8e8;
}

/* ===== 「别的」modal ===== */
.custom-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 150;
  padding: 40rpx;
  box-sizing: border-box;
}

.custom-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  width: 100%;
  max-width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;       /* 内容溢出时 modal 内部滚动 */
  display: flex;
  flex-direction: column;
}

.custom-title {
  font-weight: 600;
  color: #222;
  margin-bottom: 4rpx;
}

.custom-sub {
  color: #999;
  margin-bottom: 16rpx;
}

.custom-input {
  background: #f7f7f7;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.custom-candidates {
  flex: 1;
  overflow-y: auto;
}

.custom-candidates-title {
  color: #999;
  margin-bottom: 8rpx;
}

.custom-candidate {
  background: #fff5e6;
  color: #b8702c;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.custom-candidate:active {
  background: #ffe4c4;
}

.custom-add-new {
  background: #fff5e6;
  color: #ff9a3c;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  text-align: center;
  margin-top: 8rpx;
}

.custom-add-new:active {
  background: #ffe4c4;
}

.custom-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.custom-actions .btn-secondary {
  flex: 1;
}

/* ===== Onboarding modal ===== */
.onboard-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 40rpx;
  box-sizing: border-box;
}

.onboard-card {
  background: #fff;
  border-radius: 16rpx;
  width: 100%;
  max-width: 700rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.onboard-title {
  font-weight: 600;
  color: #2a2a2a;
  margin-bottom: 6rpx;
  flex-shrink: 0;
}

.onboard-sub {
  color: #999;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.onboard-scroll {
  flex: 1;
  max-height: 65vh;
}

.onboard-group {
  margin-bottom: 24rpx;
}

.onboard-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.onboard-group-title {
  color: #5a5a5a;
  font-weight: 500;
  padding-left: 4rpx;
}

.onboard-group-actions {
  display: flex;
  gap: 12rpx;
}

.onboard-mini-btn {
  color: #ff9a3c;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 2rpx solid #ff9a3c;
}

.onboard-mini-btn:active {
  background: #ff9a3c;
  color: #fff;
}

.onboard-mini-btn-clear {
  color: #999;
  border-color: #ddd;
}

.onboard-mini-btn-clear:active {
  background: #999;
  color: #fff;
}

.onboard-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.onboard-item {
  background: #f5f5f5;
  color: #666;
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
}

.onboard-item-on {
  background: #ff9a3c;
  color: #fff;
}

.onboard-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-shrink: 0;
}

.onboard-actions .btn-secondary {
  flex: 1;
}

.onboard-actions .btn-primary {
  flex: 2;
}

/* 小屏适配 */
@media (max-height: 640px) {
  .home { padding: 16rpx 24rpx; }
  .home-header { padding: 8rpx 0 16rpx; }
  .section { margin-bottom: 14rpx; }
  .actions { padding: 12rpx 0; }
  .big-btn { padding: 22rpx 0; }
}
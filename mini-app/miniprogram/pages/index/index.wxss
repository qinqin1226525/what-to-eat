/* pages/index/index.wxss */

.welcome {
  background: linear-gradient(135deg, #ff9a3c, #ffc26b);
  color: #fff;
}
.welcome .card-title { color: #fff; }
.welcome .text-muted { color: rgba(255, 255, 255, 0.85); }

.mode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 8rpx;
}

.mode-card {
  flex: 1 1 calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.mode-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.mode-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #222;
}

.mode-desc {
  font-size: 22rpx;
  color: #999;
}

.dish-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.dish-row:last-child {
  border-bottom: none;
}

.dish-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
}

.dish-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.tag-list {
  margin-top: 8rpx;
}

.meal-section {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.meal-section:last-child {
  border-bottom: none;
}

.meal-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff9a3c;
  margin-bottom: 12rpx;
}

.daily-card {
  background: linear-gradient(135deg, #fff7ed, #fef3c7);
}

.daily-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.daily-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  gap: 12rpx;
}

.daily-label {
  font-size: 24rpx;
  color: #666;
  width: 80rpx;
  flex-shrink: 0;
}

.daily-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
  min-width: 100rpx;
}

.daily-bar {
  height: 100%;
  background: #ff9a3c;
  transition: width 0.3s ease;
}

.daily-num {
  font-size: 22rpx;
  color: #999;
  width: 160rpx;
  text-align: right;
  flex-shrink: 0;
}

/* ===== 菜谱详情弹窗 ===== */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.detail-card {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 60rpx 32rpx;
  overflow-y: auto;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-emoji {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.detail-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}

.detail-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
  border-radius: 50%;
}

.detail-close:active {
  background: #f5f5f5;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff9a3c;
  margin: 24rpx 0 12rpx 0;
  padding-left: 4rpx;
  border-left: 6rpx solid #ff9a3c;
}

.detail-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  padding: 0 8rpx;
  word-break: break-all;
}

.detail-step {
  display: flex;
  margin: 12rpx 0;
  font-size: 28rpx;
  line-height: 1.7;
}

.step-num {
  color: #ff9a3c;
  font-weight: 600;
  width: 48rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  color: #333;
}

.detail-tip {
  background: #fff7ed;
  border-left: 6rpx solid #f59e0b;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #92400e;
  margin-top: 24rpx;
  line-height: 1.6;
}
/* 统计入口卡片 */
.stats-entry {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #e0f2fe, #ddd6fe);
  margin-top: 24rpx;
  border: none;
}

.stats-entry-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.stats-entry-text {
  flex: 1;
}

.stats-entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e3a8a;
}

.stats-entry-desc {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.stats-entry-arrow {
  font-size: 48rpx;
  color: #1e3a8a;
  font-weight: 300;
}

/* ===== 预算时间档位 ===== */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  transition: background 0.15s ease, color 0.15s ease;
}

.chip-ghost {
  background: #f5f5f5;
  color: #555;
  border: 2rpx solid transparent;
}

.chip-ghost:active {
  background: #e5e7eb;
}

.chip-on {
  background: #ff9a3c;
  color: #fff;
  border: 2rpx solid #ff9a3c;
  font-weight: 600;
}

/* ===== 场景卡片网格 ===== */
.scenario-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.scenario-card {
  flex: 1 1 calc(50% - 8rpx);
  background: linear-gradient(135deg, #fff7ed, #fef3c7);
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: transform 0.15s ease, border-color 0.15s ease;
}

.scenario-card:active {
  transform: scale(0.97);
  border-color: #ff9a3c;
}

.scenario-card-last {
  border-color: #ff9a3c;
  background: linear-gradient(135deg, #ffe8d0, #ffd8a8);
}

.scenario-emoji {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.scenario-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 4rpx;
}

.scenario-desc {
  font-size: 22rpx;
  color: #777;
}

<!-- pages/index/index.wxml -->
<view class="container">

  <!-- 今日营养进度（始终显示，未配置健康档案时显示引导） -->
  <block wx:if="{{mode === '' || mode === 'one-meal' || mode === 'three-meals' || mode === 'fridge-result' || mode === 'search'}}">
    <view class="daily-card card">
      <view class="daily-title">📊 今日营养</view>
      <block wx:if="{{targets.calories > 0}}">
        <view class="daily-row">
          <text class="daily-label">卡路里</text>
          <view class="daily-bar-wrap">
            <view class="daily-bar" style="width: {{(dailyToday.calories / targets.calories * 100) > 100 ? 100 : (dailyToday.calories / targets.calories * 100)}}%;"></view>
          </view>
          <text class="daily-num">{{dailyToday.calories}}/{{targets.calories}} kcal</text>
        </view>
        <view class="daily-row">
          <text class="daily-label">蛋白质</text>
          <view class="daily-bar-wrap">
            <view class="daily-bar" style="width: {{(dailyToday.protein / targets.protein * 100) > 100 ? 100 : (dailyToday.protein / targets.protein * 100)}}%; background: #2da44e;"></view>
          </view>
          <text class="daily-num">{{dailyToday.protein}}/{{targets.protein}} g</text>
        </view>
        <view class="daily-row">
          <text class="daily-label">碳水</text>
          <view class="daily-bar-wrap">
            <view class="daily-bar" style="width: {{(dailyToday.carbs / targets.carbs * 100) > 100 ? 100 : (dailyToday.carbs / targets.carbs * 100)}}%; background: #f59e0b;"></view>
          </view>
          <text class="daily-num">{{dailyToday.carbs}}/{{targets.carbs}} g</text>
        </view>
        <view class="daily-row">
          <text class="daily-label">脂肪</text>
          <view class="daily-bar-wrap">
            <view class="daily-bar" style="width: {{(dailyToday.fat / targets.fat * 100) > 100 ? 100 : (dailyToday.fat / targets.fat * 100)}}%; background: #ef4444;"></view>
          </view>
          <text class="daily-num">{{dailyToday.fat}}/{{targets.fat}} g</text>
        </view>
      </block>
      <block wx:else>
        <view class="text-muted">完善「我的 → 健康档案」后显示推荐摄入</view>
      </block>
    </view>
  </block>

  <!-- 模式选择（未选时） -->
  <block wx:if="{{mode === ''}}">
    <view class="welcome card">
      <view class="card-title">今天吃啥？</view>
      <view class="text-muted">基于你的口味、冰箱、近期记录智能推荐</view>
    </view>

    <view class="mode-grid">
      <view class="mode-card" data-mode="one-meal" bindtap="onMode">
        <view class="mode-icon">🍱</view>
        <view class="mode-title">一顿</view>
        <view class="mode-desc">午晚饭 · 一碗一餐或配菜模式</view>
      </view>
      <view class="mode-card" data-mode="three-meals" bindtap="onMode">
        <view class="mode-icon">🍽️</view>
        <view class="mode-title">一日三餐</view>
        <view class="mode-desc">早 + 午 + 晚</view>
      </view>
      <view class="mode-card" data-mode="budget-time" bindtap="onMode">
        <view class="mode-icon">⏱️</view>
        <view class="mode-title">预算时间</view>
        <view class="mode-desc">按可用时间选菜 · 5 档可选</view>
      </view>
      <view class="mode-card" data-mode="scenario" bindtap="onMode">
        <view class="mode-icon">🎭</view>
        <view class="mode-title">按场景</view>
        <view class="mode-desc">深夜 / 聚会 / 减脂等 6 种</view>
      </view>
      <view class="mode-card" data-mode="fridge" bindtap="onMode">
        <view class="mode-icon">🥬</view>
        <view class="mode-title">冰箱有什么</view>
        <view class="mode-desc">食材→能做的菜</view>
      </view>
      <view class="mode-card" data-mode="search" bindtap="onMode">
        <view class="mode-icon">🔍</view>
        <view class="mode-title">搜菜谱</view>
        <view class="mode-desc">菜名/食材/标签</view>
      </view>
    </view>

    <!-- 统计入口 -->
    <view class="stats-entry card" bindtap="onOpenStats">
      <view class="stats-entry-icon">📊</view>
      <view class="stats-entry-text">
        <view class="stats-entry-title">查看 7 天营养统计</view>
        <view class="stats-entry-desc">趋势曲线 / 多样性 / 周报</view>
      </view>
      <view class="stats-entry-arrow">›</view>
    </view>

    <!-- AI 顾问入口 -->
    <view class="stats-entry card" bindtap="onOpenAI" style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
      <view class="stats-entry-icon">🤖</view>
      <view class="stats-entry-text">
        <view class="stats-entry-title">AI 饮食顾问</view>
        <view class="stats-entry-desc">个性化推荐 · 解读今日营养 · 教做菜</view>
      </view>
      <view class="stats-entry-arrow">›</view>
    </view>
  </block>

  <!-- 一顿 -->
  <block wx:if="{{mode === 'one-meal' && result}}">
    <view class="card">
      <view class="card-title">今天这一顿</view>
      <view class="text-muted" style="margin-bottom:20rpx;">
        <block wx:if="{{result.isOneBowl}}">一碗一餐 · 不配菜不配汤</block>
        <block wx:elif="{{result.isCombo}}">配菜模式 · 主菜 + 汤 + 主食</block>
      </view>
      <block wx:for="{{result.dishes}}" wx:key="name" wx:for-item="dish">
        <view class="dish-row" data-dish="{{dish}}" bindtap="showDishDetail">
          <view class="dish-emoji">{{dish.emoji}}</view>
          <view class="dish-info">
            <view class="dish-name">{{dish.name}}</view>
            <view class="dish-meta">约 {{dish.time_minutes}} 分钟</view>
          </view>
          <view class="swap-btn" data-slot="{{dish._slot}}" catchtap="onSwapOneDish">换这道</view>
        </view>
      </block>
      <view class="divider"></view>
      <view style="display:flex;gap:16rpx;">
        <view style="flex:1;">
          <button class="btn-primary" data-dish="{{result.recordDish}}" data-meal="" bindtap="confirmEat">就它了</button>
        </view>
        <view style="flex:1;">
          <button class="btn-secondary" bindtap="reroll">换一组</button>
        </view>
      </view>
      <view style="margin-top:16rpx;">
        <button class="btn-ghost" bindtap="reset">返回</button>
      </view>
    </view>
  </block>

  <!-- 预算时间：档位选择 -->
  <block wx:if="{{mode === 'budget-time'}}">
    <view class="card">
      <view class="card-title">⏱️ 你最多能花多少时间？</view>
      <view class="text-muted" style="margin-bottom:24rpx;">选个档位，3 秒拿到推荐菜</view>
      <view class="chip-row">
        <block wx:for="{{budgetOptions}}" wx:key="value" wx:for-item="opt">
          <view class="chip {{selectedBudgetTime === opt.value ? 'chip-on' : 'chip-ghost'}}"
                data-minutes="{{opt.value}}" bindtap="onBudgetTimeSelect">
            {{opt.label}}
          </view>
        </block>
      </view>
      <view wx:if="{{lastBudgetTime > 0 && selectedBudgetTime !== lastBudgetTime}}"
            style="margin-top:20rpx;font-size:24rpx;color:#999;">
        💡 上次选了 {{lastBudgetTime}} 分钟
      </view>
    </view>
    <view style="margin-top:16rpx;">
      <button class="btn-ghost" bindtap="reset">返回</button>
    </view>
  </block>

  <!-- 预算时间：结果（复用 one-meal 结构） -->
  <block wx:if="{{mode === 'budget-time-result' && result}}">
    <view class="card">
      <view class="card-title">⏱️ {{selectedBudgetTime > 0 ? selectedBudgetTime + ' 分钟内' : '不限时间'}} 推荐</view>
      <view class="text-muted" style="margin-bottom:20rpx;">
        <block wx:if="{{result.isOneBowl}}">一碗一餐 · 不配菜不配汤</block>
        <block wx:elif="{{result.isCombo}}">配菜模式 · 主菜 + 汤 + 主食</block>
        <block wx:else>按时间筛选 · 不超过 {{selectedBudgetTime || '∞'}} 分钟</block>
      </view>
      <block wx:for="{{result.dishes}}" wx:key="name" wx:for-item="dish">
        <view class="dish-row" data-dish="{{dish}}" bindtap="showDishDetail">
          <view class="dish-emoji">{{dish.emoji}}</view>
          <view class="dish-info">
            <view class="dish-name">{{dish.name}}</view>
            <view class="dish-meta">约 {{dish.time_minutes}} 分钟</view>
          </view>
          <view class="swap-btn" data-slot="{{dish._slot}}" catchtap="onSwapOneDish">换这道</view>
        </view>
      </block>
      <view wx:if="{{result.dishes.length === 0}}" class="text-muted text-center" style="padding:40rpx 0;">
        😢 {{selectedBudgetTime}} 分钟内没找到合适的菜，换个档位试试
      </view>
      <view class="divider"></view>
      <view style="display:flex;gap:16rpx;">
        <view style="flex:1;">
          <button class="btn-primary" data-dish="{{result.recordDish}}" data-meal="" bindtap="confirmEat">就它了</button>
        </view>
        <view style="flex:1;">
          <button class="btn-secondary" bindtap="onBudgetTimeReset">换档位</button>
        </view>
      </view>
      <view style="margin-top:16rpx;">
        <button class="btn-ghost" bindtap="reset">返回</button>
      </view>
    </view>
  </block>

  <!-- 场景：场景卡片网格 -->
  <block wx:if="{{mode === 'scenario'}}">
    <view class="card">
      <view class="card-title">🎭 今天什么场合？</view>
      <view class="text-muted" style="margin-bottom:24rpx;">为不同场景挑专属菜单</view>
      <view wx:if="{{lastScenario && selectedScenario}}"
            class="text-muted" style="margin-bottom:20rpx;font-size:24rpx;">
        💡 上次选了「{{selectedScenario.name}}」 — 直接进入点 <text style="color:#ff9a3c;" bindtap="onScenarioQuickContinue">继续</text>，换别的选下方
      </view>
      <view class="scenario-grid">
        <block wx:for="{{scenarios}}" wx:key="id" wx:for-item="sc">
          <view class="scenario-card {{lastScenario === sc.id ? 'scenario-card-last' : ''}}"
                data-id="{{sc.id}}" bindtap="onScenarioSelect">
            <view class="scenario-emoji">{{sc.emoji}}</view>
            <view class="scenario-name">{{sc.name}}</view>
            <view class="scenario-desc">{{sc.desc}}</view>
          </view>
        </block>
      </view>
    </view>
    <view style="margin-top:16rpx;">
      <button class="btn-ghost" bindtap="reset">返回</button>
    </view>
  </block>

  <!-- 场景：结果（复用 dish-row） -->
  <block wx:if="{{mode === 'scenario-result' && result && selectedScenario}}">
    <view class="card">
      <view class="card-title">{{selectedScenario.emoji}} {{selectedScenario.name}}</view>
      <view class="text-muted" style="margin-bottom:20rpx;">{{selectedScenario.desc}}</view>
      <block wx:for="{{result.dishes}}" wx:key="name" wx:for-item="dish">
        <view class="dish-row" data-dish="{{dish}}" bindtap="showDishDetail">
          <view class="dish-emoji">{{dish.emoji}}</view>
          <view class="dish-info">
            <view class="dish-name">{{dish.name}}</view>
            <view class="dish-meta">约 {{dish.time_minutes}} 分钟</view>
          </view>
          <view class="swap-btn" data-slot="{{dish._slot}}" catchtap="onSwapScenarioDish">换这道</view>
        </view>
      </block>
      <view wx:if="{{result.dishes.length === 0}}" class="text-muted text-center" style="padding:40rpx 0;">
        😢 这个场景暂时没合适的，换个场景试试
      </view>
      <view class="divider"></view>
      <view style="display:flex;gap:16rpx;">
        <view style="flex:1;">
          <button class="btn-primary" data-dish="{{result.recordDish}}" data-meal="" bindtap="confirmEat">就它了</button>
        </view>
        <view style="flex:1;">
          <button class="btn-secondary" bindtap="onScenarioReset">换场景</button>
        </view>
      </view>
      <view style="margin-top:16rpx;">
        <button class="btn-ghost" bindtap="reset">返回</button>
      </view>
    </view>
  </block>

  <!-- 一日三餐 -->
  <block wx:if="{{mode === 'three-meals' && result}}">
    <view class="card">
      <view class="card-title">一日三餐</view>
      <view class="meal-section">
        <view class="meal-label">☀️ 早餐</view>
        <view wx:if="{{result.breakfast}}" class="dish-row" data-dish="{{result.breakfast}}" bindtap="showDishDetail">
          <view class="dish-emoji">{{result.breakfast.emoji}}</view>
          <view class="dish-info">
            <view class="dish-name">{{result.breakfast.name}}</view>
            <view class="dish-meta">约 {{result.breakfast.time_minutes}} 分钟</view>
          </view>
        </view>
        <view wx:else class="text-muted">（跳过）</view>
      </view>
      <view class="meal-section">
        <view class="meal-label">🌞 午餐</view>
        <block wx:if="{{result.lunch.isOneBowl && result.lunch.dishes.length > 0}}">
          <view class="dish-row" data-dish="{{result.lunch.dishes[0]}}" bindtap="showDishDetail">
            <view class="dish-emoji">🍜</view>
            <view class="dish-info">
              <view class="dish-name">{{result.lunch.dishes[0].name}}</view>
              <view class="dish-meta">一碗一餐 · 约 {{result.lunch.dishes[0].time_minutes}} 分钟</view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{result.lunch.dishes}}" wx:key="name" wx:for-item="dish">
            <view class="dish-row" data-dish="{{dish}}" bindtap="showDishDetail">
              <view class="dish-emoji">{{dish.emoji}}</view>
              <view class="dish-info">
                <view class="dish-name">{{dish.name}}</view>
                <view class="dish-meta">约 {{dish.time_minutes}} 分钟</view>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="meal-section">
        <view class="meal-label">🌙 晚餐</view>
        <block wx:if="{{result.dinner.isOneBowl && result.dinner.dishes.length > 0}}">
          <view class="dish-row" data-dish="{{result.dinner.dishes[0]}}" bindtap="showDishDetail">
            <view class="dish-emoji">🍜</view>
            <view class="dish-info">
              <view class="dish-name">{{result.dinner.dishes[0].name}}</view>
              <view class="dish-meta">一碗一餐 · 约 {{result.dinner.dishes[0].time_minutes}} 分钟</view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{result.dinner.dishes}}" wx:key="name" wx:for-item="dish">
            <view class="dish-row" data-dish="{{dish}}" bindtap="showDishDetail">
              <view class="dish-emoji">{{dish.emoji}}</view>
              <view class="dish-info">
                <view class="dish-name">{{dish.name}}</view>
                <view class="dish-meta">约 {{dish.time_minutes}} 分钟</view>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="divider"></view>
      <button class="btn-primary" bindtap="reroll">换一组</button>
      <view style="margin-top:16rpx;">
        <button class="btn-ghost" bindtap="reset">返回</button>
      </view>
    </view>
  </block>

  <!-- 冰箱输入 -->
  <block wx:if="{{mode === 'fridge'}}">
    <view class="card">
      <view class="card-title">冰箱有什么？</view>
      <view class="text-muted" style="margin-bottom:20rpx;">输入食材（逗号或空格分隔），如"鸡蛋 西红柿"</view>
      <textarea class="input" value="{{ingredientsInput}}" bindinput="onFridgeInput" placeholder="鸡蛋, 西红柿, 葱…" maxlength="100" auto-height />
      <view style="margin-top:24rpx;">
        <button class="btn-primary" bindtap="onFridgeConfirm">查能做什么</button>
      </view>
      <view style="margin-top:16rpx;">
        <button class="btn-ghost" bindtap="reset">取消</button>
      </view>
    </view>
  </block>

  <!-- 冰箱结果 -->
  <block wx:if="{{mode === 'fridge-result'}}">
    <view class="card">
      <view class="card-title">冰箱：{{fridgeItemsStr}}</view>
      <view class="text-muted" style="margin-bottom:20rpx;">找到 {{feasible.length}} 道菜</view>
      <block wx:if="{{feasible.length === 0}}">
        <view class="text-muted text-center">没找到合适的菜，去买点啥吧 😄</view>
      </block>
      <block wx:for="{{feasible}}" wx:key="name" wx:for-item="dish">
        <view class="dish-row">
          <view class="dish-info">
            <view class="dish-name">{{dish.name}}</view>
            <view class="dish-meta">{{dish.time_minutes}} 分钟 · {{dish.role}}</view>
            <view class="tag-list">
              <text wx:for="{{dish.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
            </view>
          </view>
        </view>
      </block>
      <view class="divider"></view>
      <button class="btn-ghost" bindtap="reset">返回</button>
    </view>
  </block>

  <!-- 搜索 -->
  <block wx:if="{{mode === 'search'}}">
    <view class="card">
      <view class="card-title">搜菜谱</view>
      <input class="input" value="{{searchInput}}" bindinput="onSearchInput" placeholder="菜名 / 食材 / 标签" confirm-type="search" />
    </view>
    <view wx:if="{{searchResults.length > 0}}" class="card">
      <view class="text-muted" style="margin-bottom:16rpx;">{{searchResults.length}} 条结果</view>
      <block wx:for="{{searchResults}}" wx:key="name" wx:for-item="dish">
        <view class="dish-row" data-dish="{{dish}}" bindtap="showDishDetail">
          <view class="dish-info">
            <view class="dish-name">{{dish.name}}</view>
            <view class="dish-meta">{{dish.time_minutes}} 分钟 · {{dish.role}}</view>
            <view class="tag-list">
              <text wx:for="{{dish.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
    <view style="margin-top:16rpx;">
      <button class="btn-ghost" bindtap="reset">返回</button>
    </view>
  </block>

  <!-- 菜谱详情弹窗（覆盖所有页面） -->
  <view wx:if="{{showDetail && detailDish}}" class="detail-mask" bindtap="closeDishDetail">
    <view class="detail-card" catchtap="">
      <view class="detail-header">
        <view class="detail-emoji">{{detailDish.emoji}}</view>
        <view class="detail-title">{{detailDish.name}}</view>
        <view class="detail-close" bindtap="closeDishDetail">✕</view>
      </view>
      <view class="detail-meta">
        <text class="tag">{{detailDish.role}}</text>
        <text class="tag">⏱ {{detailDish.time_minutes}} 分钟</text>
        <text wx:for="{{detailDish.tags}}" wx:key="*this" wx:for-item="t" class="tag">{{t}}</text>
      </view>

      <block wx:if="{{detailDish.ingredients && detailDish.ingredients.length > 0}}">
        <view class="detail-section-title">🥕 食材</view>
        <view class="detail-text">{{detailDish.ingredientsStr}}</view>
      </block>

      <block wx:if="{{detailDish.seasonings && detailDish.seasonings.length > 0}}">
        <view class="detail-section-title">🧂 调料</view>
        <view class="detail-text">{{detailDish.seasoningsStr}}</view>
      </block>

      <block wx:if="{{detailDish.steps && detailDish.steps.length > 0}}">
        <view class="detail-section-title">📝 做法</view>
        <view wx:for="{{detailDish.steps}}" wx:key="*this" wx:for-item="step" wx:for-index="idx" class="detail-step">
          <text class="step-num">{{idx + 1}}.</text>
          <text class="step-text">{{step}}</text>
        </view>
      </block>

      <block wx:if="{{detailDish.tip}}">
        <view class="detail-tip">💡 {{detailDish.tip}}</view>
      </block>

      <block wx:if="{{(!detailDish.steps || detailDish.steps.length === 0) && (!detailDish.tip)}}">
        <view class="text-muted text-center" style="padding:32rpx 0;font-size:24rpx;">调料/做法/小贴士暂无，仅显示食材</view>
      </block>
    </view>
  </view>

</view>
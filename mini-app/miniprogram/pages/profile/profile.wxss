/* pages/profile/profile.wxss */

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-label {
  color: #666;
  font-size: 26rpx;
}

.info-value {
  color: #222;
  font-size: 24rpx;
}

.mono {
  font-family: Menlo, Consolas, monospace;
}

.section {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.section:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  background: #f5f5f5;
  color: #666;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.chip-on {
  background: #ff9a3c;
  color: #fff;
}

.chip-ghost {
  background: #f5f5f5;
  color: #666;
}

.targets-summary {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #eee;
}

.target-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  font-size: 28rpx;
}

.target-num {
  color: #ff9a3c;
  font-weight: 600;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}
/* ===== 添加新菜表单 ===== */
.form-section {
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-section:last-of-type {
  border-bottom: none;
}

.form-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  font-size: 28rpx;
  padding: 8rpx 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
  min-height: 48rpx;
}

/* AI 填充按钮 */
.ai-fill-btn {
  background: linear-gradient(135deg, #8b5cf6, #a78bfa);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.ai-fill-btn[disabled] {
  background: #ccc;
  color: #fff;
}

/* ===== AI 聊口味 ===== */
.ai-chat-btn {
  background: linear-gradient(135deg, #fff5e6, #ffe4c4);
  border: 2rpx solid #ff9a3c;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.ai-chat-btn:active {
  background: linear-gradient(135deg, #ffe4c4, #ffd6a8);
}

.ai-chat-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.ai-chat-text {
  flex: 1;
}

.ai-chat-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2a2a2a;
  margin-bottom: 4rpx;
}

.ai-chat-sub {
  color: #999;
}

.ai-chat-arrow {
  color: #ff9a3c;
  font-size: 36rpx;
  font-weight: 300;
}

.custom-note-display {
  background: #fff8eb;
  color: #8a6d3b;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* AI chat modal */
.ai-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 32rpx;
  box-sizing: border-box;
}

.ai-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 16rpx;
  width: 100%;
  max-width: 680rpx;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
}

.ai-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.ai-title {
  font-weight: 600;
  color: #2a2a2a;
}

.ai-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 36rpx;
}

.ai-sub {
  color: #999;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.ai-chat-scroll {
  flex: 1;
  max-height: 60vh;
  margin-bottom: 12rpx;
}

.ai-msg {
  margin-bottom: 12rpx;
  display: flex;
}

.ai-msg-user {
  justify-content: flex-end;
}

.ai-msg-ai {
  justify-content: flex-start;
}

.ai-msg-bubble {
  background: #f5f5f5;
  color: #2a2a2a;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  max-width: 80%;
  line-height: 1.5;
  word-break: break-word;
}

.ai-msg-user .ai-msg-bubble {
  background: #ff9a3c;
  color: #fff;
}

.ai-msg-explanation {
  color: #2da44e;
  margin-top: 4rpx;
  padding: 0 8rpx;
}

.ai-input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.ai-input {
  flex: 1;
  background: #f7f7f7;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  min-width: 0;
}

.ai-send-btn {
  flex-shrink: 0;
  background: #ff9a3c;
  color: #fff;
  border-radius: 10rpx;
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.ai-send-btn:active { opacity: 0.8; }
.ai-send-btn.disabled { opacity: 0.5; }
